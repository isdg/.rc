# Linked to ~/.hr/.hrrc; hr only reads it. $HR_VAULT or the vault you are
# in overrides the vault below; a key in a vault's hr.toml overrides the rest.

# The vault hr uses outside any vault, launchd jobs included.
vault = "~/feed"

# Sort order for `hr list` / `hr feed`. "desc" = newest first.
ordering = "desc"

# Mark items read when their file is opened (requires nvim autocmd).
autoread = false

# User-Agent for HTTP requests.
user_agent = "hrb/0.1"
