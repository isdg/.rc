# Example ~/.zshrc.local — a starting point, not a live file. Copy it out:
#
#     cp "$ISGRC/zsh/zshrc.local.example" ~/.zshrc.local
#
# ~/.zshrc sources ~/.zshrc.local after every enabled zsh/rc.d/ fragment and
# zsh/banner.zsh, so anything set here overrides them, and before
# banner_render, so log_ssh and the other banner log functions see the final
# values. Missing file is fine — the source is guarded.
#
# Why $HOME and not the repo: ~/.zshrc is a symlink into the ~/.rc working tree,
# so a value kept on a setup/<machine> branch follows HEAD and empties itself
# the moment you check out anything else. That failed quietly — a shell opened
# while the repo sat on main got SSH_KEYS empty and log_ssh, whose empty-list
# guard only fires when no agent is reachable, printed "ssh-agent · 1 key" and
# loaded no key at all. $HOME is not a checkout, so this file survives.
#
# Sibling convention: zsh/aliases.ignored.zsh is the same idea for aliases and
# functions — gitignored, in-repo, sourced by 15-aliases.zsh when present. Use
# that one for shell sugar; use this one for what the box *is*.
#
# Machine-local means true of this box, not of the config: keys it holds, tools
# only it has, escape hatches only it needs. Preferences belong in the tracked
# files, where every machine gets them.

# ── ssh ──
# Private halves log_ssh loads into the ssh-agent at each interactive login.
# Paths, not fingerprints. A key whose .pub is missing still loads, it just
# prints without the type/fingerprint tag; a path that does not exist is
# reported on the banner rather than being fatal. Encrypted keys are never
# unlocked here — those stay a deliberate `ssh-add` you run by hand.
SSH_KEYS=( ~/.ssh/delos-new )

# ── environment ──
# Tools installed somewhere only this box knows about: psql & friends from
# keg-only libpq (client tools only).
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# xcrun picks the stale MacOSX27.0.sdk, whose arm64e.x1 tbds the CLT 26
# linker rejects; MacOSX.sdk tracks the SDK matching the installed tools.
export SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk

# Per-repo escape hatches. Example: cosmos-saas's sync-env lefthook hook runs
# `asdf plugin add supabase` on every merge and checkout, and its .tool-versions
# pin can never match the Homebrew supabase on PATH. Remove the line to restore
# it; run `uv sync` by hand when uv.lock changes.
export LEFTHOOK_EXCLUDE=sync-env

# Services reached only over a VPN. Placeholders: real addresses stay in the
# live file, never in this tracked one.
# export LOKI_ADDR=http://loki.internal.example:3100
# export VAULT_ADDR=https://vault.internal.example:8200

# ── completions ──
# Docker Desktop appends this on install. Guarded here: without the directory
# _comps[docker] stays unset and the second compinit runs on every shell.
if [[ -d ~/.docker/completions ]]; then
    fpath=(~/.docker/completions $fpath)
    autoload -Uz compinit
    (( ${+_comps[docker]} )) || compinit
fi

# Scaleway CLI completion, cached until scw changes. Its script reruns a full
# compinit on every shell; that line is dropped, 03-completion already ran it.
_zsh_cached scw "$commands[scw]" -- \
    sh -c 'scw autocomplete script shell=zsh | grep -v compinit' \
    && source $REPLY

# ── banner ──
# Two lines: the mascot's head, its δ and user@host, then the session kind
# and startup time. The modes are listed at the top of zsh/banner.zsh.
BANNER_MODE='mini nologs'

# Secrets: prefer a lookup over a literal, so the value is not sitting in a
# plaintext dotfile that a stray `cat ~/.zshrc.local` or screen share exposes.
# export SOME_TOKEN="$(security find-generic-password -w -s some-token 2>/dev/null)"
