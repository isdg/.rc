" ============================================================
"   .vimrc.core — portable comfort layer
" ============================================================
" The plugin-free part of ~/.vimrc: the rc.d/ fragments that sort before
" 09-plugins.vim. Same keys, the plugin ones on vim's built-ins instead
" (02-builtins.vim). Nothing here needs node, git, curl or a network.
"
" Use it:
"   vim  -u ~/.rc/vim/.vimrc.core file
"   nvim -u ~/.rc/vim/.vimrc.core file
"   cd ~/.rc/vim/rc.d && cat $(ls | sed '/-plugins\.vim$/,$d') |
"     ssh host 'cat > ~/.vimrc'                  " remote box, one file
"
" Needs +eval; tiny builds without it skip the loop and start bare.

" vim -u keeps vi-compatible mode, which would also stop netrw loading.
silent! set nocompatible

if 1
  " vim -u leaves it unset; 02-builtins.vim's <leader>R reloads it.
  if empty($MYVIMRC) | let $MYVIMRC = expand('<sfile>:p') | endif
  let s:rc_d = fnamemodify(resolve(expand('<sfile>:p')), ':h') . '/rc.d'
  for s:frag in sort(glob(s:rc_d . '/[0-9][0-9]-*.vim', 0, 1))
    if s:frag =~# '-plugins\.vim$' | break | endif
    execute 'source' fnameescape(s:frag)
  endfor
  unlet s:rc_d s:frag
endif
