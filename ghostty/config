# Ghostty config — light theme, JetBrains Mono ExtraLight

# --- font ---
# Families and styles available (`ghostty +list-fonts`):
#   JetBrains Mono  ExtraLight, Light, Regular, Medium (no bold/italic files)
#   Menlo           Regular, Bold, Italic, Bold Italic
#   Courier New     Regular, Bold, Italic, Bold Italic
#   PT Mono         Regular, Bold
#   Andale Mono, Monaco   Regular only
# Missing bold/italic is synthesized (font-synthetic-style, on by default).
# Defaults: font-family unset = Ghostty's built-in JetBrains Mono (+ Nerd Font
# symbols), font-style = default (Regular), font-size = 13, no cell adjust.
font-family = JetBrains Mono
font-style = Light
font-style-bold = false
font-size = 15
adjust-cell-height = 25%
adjust-cell-width = -5%
font-feature = -liga
font-feature = -calt
# zoom in half-point steps (default is 1)
keybind = super+==increase_font_size:0.5
keybind = super++=increase_font_size:0.5
keybind = super+-=decrease_font_size:0.5

# --- theme (light/dark) ---
# theme + bg/fg/cursor colors live in theme-dark.conf / theme-light.conf and
# are selected by the theme-active.conf symlink, flipped by toggle_theme.sh
# from the ~/.config/isg/theme source of truth. Put alternate themes there.
config-file = theme-active.conf

cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = false
selection-background = f81ce5
selection-foreground = ffffff

# --- window / layout ---
# window-padding-x is written into width-active.conf by width.sh (alias `ww`):
# `ww` toggles 400/600, `ww N` sets any width. That file is gitignored, so
# widening the text column never shows up as a diff in this tracked one.
# Larger padding = narrower text. Reload with cmd+shift+, to apply.
config-file = width-active.conf
window-padding-y = 12
window-padding-balance = true
window-save-state = always
# tabs integrated into the titlebar — most compact tab-friendly option
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
window-show-tab-bar = never
# fullscreen in place: a native-fullscreen Space makes every app switch animate
macos-non-native-fullscreen = true

# --- behavior ---
bold-is-bright = true
copy-on-select = false
mouse-hide-while-typing = true
confirm-close-surface = false
shell-integration = detect
# auto-installs xterm-ghostty terminfo on remote hosts via `ssh` wrapper (needs
# Ghostty 1.4.0+ client-side; falls back to TERM=xterm-256color if tic fails)
shell-integration-features = ssh-env,ssh-terminfo

# --- behavior ---

macos-option-as-alt = true

