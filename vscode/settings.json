{
  // ─── Editor Settings
  // ────────────────────────────────────────────────────────────
  "editor.cursorBlinking": "solid",
  "editor.fontFamily": "JetBrains Mono ExtraLight",
  "editor.fontSize": 12, // 11.7 vim //  12 vim style // 12.3 JB style
  "editor.lineHeight": 19.0, // 18  vim // 19 vim style   // 22 JB style
  "editor.letterSpacing": 0,
  "editor.rulers": [80],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 79,
  "workbench.fontAliasing": "default",
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.tabCompletion": "on",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.inlineSuggest.enabled": false,
  // ─── Optional: Turn off suggestions completely ─────────────────────────────────
  // "_editor.quickSuggestions": false,
  // "_editor.suggestOnTriggerCharacters": false,
  // "_editor.suggest.enabled": false,
  // "_editor.parameterHints.enabled": false,
  // "_editor.wordBasedSuggestions": "off",
  "editor.minimap.enabled": false,
  "editor.minimap.showSlider": "always",
  "editor.minimap.renderCharacters": false,
  "editor.stickyScroll.enabled": false,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",
  "editor.lightbulb.enabled": "off",
  "editor.dragAndDrop": false,
  "editor.folding": false,
  "editor.renderWhitespace": "selection",
  "editor.occurrencesHighlight": "off",
  "editor.cursorSurroundingLines": 3,
  "editor.showFoldingControls": "never",
  "editor.scrollbar.ignoreHorizontalScrollbarInContentHeight": true,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.unicodeHighlight.allowedCharacters": { "σ": true },
  "editor.wrappingStrategy": "advanced",
  "editor.accessibilitySupport": "off",

  // ─── Workbench Appearance ──────────────────────────────────────────────────────
  "workbench.sideBar.location": "left",
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.navigationControl.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "none",
  "workbench.statusBar.visible": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.opensMaximized": "never",
  "workbench.layoutControl.enabled": true,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.colorTheme": "Visual Studio Light",
  "workbench.preferredDarkColorTheme": "Visual Studio Dark",
  "workbench.preferredLightColorTheme": "Visual Studio Light",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 15,
  "workbench.editor.limit.excludeDirty": true,
  "workbench.editor.centeredLayoutAutoResize": true,
  "workbench.editor.centeredLayoutFixedWidth": true,
  "workbench.editor.openSideBySideDirection": "down",
  "workbench.editor.revealIfOpen": false,
  "workbench.editor.enablePreview": false,
  "explorer.autoReveal": false,
  "workbench.colorCustomizations": {
    "[Visual Studio Dark]": {
      "editor.background": "#2f2f2f",
      "sideBar.background": "#2f2f2f",
      "editor.lineHighlightBorder": "#2f2f2f", // the bounding line color
      "editor.foreground": "#d2d2d2",
      "editorLineNumber.foreground": "#555555",
      "editorLineNumber.activeForeground": "#888888",
    },

    // ———— Color guide
    //  a little grayer white theme for ~17:00
    //    #e0e0e0
    //
    //  a slightly grey one
    //    #f2f2f2
    //
    //  a default one
    //    #fafafa

    "[Visual Studio Light]": {
      "editor.background": "#fafafa",
      "sideBar.background": "#fafafa",
      "editor.lineHighlightBorder": "#fafafa", // the bounding line color
      "editor.foreground": "#000000",
      "editorLineNumber.foreground": "#c0c0c0",
      "editorLineNumber.activeForeground": "#999999",
    },
  },
  "editor.tokenColorCustomizations": {
    "[Visual Studio Dark]": {
      "textMateRules": [
        {
          "scope": ["comment"],
          "settings": {
            "foreground": "#888888",
          },
        },
      ],
    },
    "[Visual Studio Light]": {
      "textMateRules": [
        {
          "scope": ["comment"],
          "settings": {
            "foreground": "#999999",
          },
        },
      ],
    },
  },

  // ─── Zen Mode ──────────────────────────────────────────────────────────────────
  "_comment_zen": "Zen Mode configuration",
  "zenMode.fullScreen": true,
  "zenMode.restore": true,
  "zenMode.centerLayout": true,
  "zenMode.showTabs": "none",
  "zenMode.hideLineNumbers": true,

  // ─── Python / Ruff
  // ─────────────────────────────────────────
  "_comment_python": "Python and Ruff settings",
  "_python.analysis.inlayHints.variableTypes": true,
  "_python.defaultInterpreterPath": "/usr/local/bin/python3.14",
  "ruff.lineLength": 79,
  "ruff.configurationPreference": "filesystemFirst",
  "_ruff.path": [
    "/Users/isaigordeev/Desktop/millenium-falcon-challenge/.venv/bin/ruff",
  ],
  // ─── C++ Configuration
  // ─────────────────────────────────────────
  "_comment_cpp": "C/C++ language server configuration",
  "_C_Cpp.default.cppStandard": "c++20",
  "_C_Cpp.formatting": "clangFormat",
  "_C_Cpp.clang_format_path": "/usr/local/opt/llvm@17/bin/clang-format",
  "_C_Cpp.intelliSenseEngine": "default",
  "_C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.clang_format_fallbackStyle": "",

  // ─── Explorer and Window ───────────────────────────────────────────────────────
  "explorer.openEditors.visible": 1,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.decorations.badges": false,
  "breadcrumbs.enabled": false,
  "breadcrumbs.filePath": "last",
  "breadcrumbs.symbolPath": "last",
  "breadcrumbs.icons": false,
  "breadcrumbs.symbolSortOrder": "position",
  "window.title": "${dirty}${activeEditorShort}${separator}${rootName}",
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "windowed",
  "window.zoomLevel": 0.33,
  "chat.commandCenter.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,

  // ─── Search & GitLens ──────────────────────────────────────────────────────────
  "search.searchEditor.focusResultsOnSearch": false,
  "search.quickOpen.includeSymbols": false,
  "search.quickAccess.preserveInput": true,
  "search.quickOpen.history.filterSortOrder": "recency",
  "search.quickOpen.includeHistory": true,
  "search.showLineNumbers": true,
  "workbench.quickOpen.preserveInput": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.hovers.currentLine.enabled": false,
  "gitlens.hovers.annotations.enabled": false,
  "gitlens.strings.codeLens.unsavedChanges.authorsOnly": "",
  "gitlens.strings.codeLens.unsavedChanges.recentChangeAndAuthors": "",
  "gitlens.codeLens.recentChange.enabled": false,
  "git.blame.editorDecoration.enabled": false,
  "diffEditor.renderSideBySide": false, // false for inline view
  "diffEditor.experimental.useTrueInlineView": false,

  // ─── Markdown / Plain text / JSONC Formatting ───────────────────────────────────────────────
  "_palace.config": "Palace config for md editing",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.rulers": [72],
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "editor.formatOnPaste": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.detectIndentation": false,
    "prettier.printWidth": 66,
    "prettier.proseWrap": "always",
  },
  "[plaintext]": {
    "editor.rulers": [67, 79],
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.detectIndentation": false,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[asm]": {
    "editor.wordWrap": "off",
  },
  "[s]": {
    "editor.wordWrap": "off",
  },
  "[nasm]": {
    "editor.wordWrap": "off",
  },
  // ─── Terminal
  // ─────────────────────────────────────────────────────────────

  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.revealOnOutput": false,
  "terminal.integrated.focusAfterRun": "none",
  "terminal.integrated.confirmOnExit": "always",
  "terminal.integrated.confirmOnKill": "hasChildProcesses",
  "terminal.integrated.tabs.title": "${sequence}: ${process} - ${separator}",
  "terminal.integrated.tabs.description": "${cwd}",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.scrollback": 10000,
  "accessibility.signals.terminalBell": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signalOptions.volume": 0,

  // ─── Miscellaneous ─────────────────────────────────────────────────────────────
  "extensions.ignoreRecommendations": true,
  "problems.sortOrder": "position",
  "python.defaultInterpreterPath": "/usr/local/bin/python3.14",
  "claudeCode.useTerminal": true,

  // ─── AI: disable AI features (GitLens AI, GitHub Copilot, inline suggestions)
  // Set these to turn AI features off. To re-enable, restore the original values
  "gitlens.ai.enabled": false,
  "chat.agent.enabled": false,
  "chat.disableAIFeatures": true,
  "terminal.integrated.suggest.inlineSuggestion": "off",
  "github.copilot.enable": {
    "*": false,
  },

  // ─── Vim Configuration ─────────────────────────────────────────────────────────
  "_comment_vim": "Vim configuration",
  "vim.leader": " ",
  "vim.useSystemClipboard": false,

