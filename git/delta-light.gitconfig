# delta, light mode — GENERATED by theme/generate.sh.
# Edit theme/palette.sh, not this file.
#
# Included by ~/.gitconfig through the delta-active.gitconfig symlink, which
# toggle_theme.sh flips — the same idiom as ghostty, k9s, tig and fzf. Only the
# two settings that actually depend on the mode live here; everything else in
# [delta] uses ANSI colour names and already followed the terminal.
#
# git processes an [include] where it appears, so these override the values in
# .gitconfig above it. A missing symlink is silently ignored by git, which is why
# bootstrap seeds it.
[delta]
	# delta only asks whether the background is light; it cannot see the theme.
	light = true
	# The line-number gutter for context lines. Same role bat uses for its
	# gutterForeground and the editors use for LineNr, so the numbers beside a
	# diff match the numbers beside a file.
	line-numbers-zero-style = "#c0c0c0"
