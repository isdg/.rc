*.DS_Store
vscode/tasks.json
**launch.json
*.swp
.claude/worktrees

# Active ghostty theme include — a symlink to theme-{dark,light}.conf, flipped
# by toggle_theme.sh. Per-machine state, not tracked.
ghostty/theme-active.conf

# Active ghostty width include — a symlink to width-{300,500,600}.conf, cycled
# by width.sh (alias `ww`). Untracked for the same reason as the theme include:
# the value changes constantly and the tracked config must stay clean.
ghostty/width-active.conf

# Active k9s skin — a symlink to skins/vs_{dark,light}.yaml, flipped by
# toggle_theme.sh (k9s config.yaml points ui.skin at it). Per-machine state.
k9s/skins/skin-active.yaml

# Active tig theme — a symlink to theme-{dark,light}.tigrc, flipped by
# toggle_theme.sh (.tigrc sources it with -q). Per-machine state.
tig/theme-active.tigrc

# Active fzf options file — a symlink to opts-{dark,light}.conf, flipped by
# toggle_theme.sh ($FZF_DEFAULT_OPTS_FILE points at it, see zsh/.zshenv).
fzf/opts-active.conf

# Machine-local zsh aliases/functions (work-specific, private repo names, etc.)
# sourced by aliases.zsh if present. Never published.
zsh/aliases.ignored.zsh
