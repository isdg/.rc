# =============================================================================
# .tigrc — tig configuration
# https://jonas.github.io/tig/doc/tigrc.5.html
# =============================================================================

# -- General settings ---------------------------------------------------------

# Show dates as relative time (e.g. "2 hours ago")
set main-view-date = relative

# Hide the author column in main view
set main-view-author = no

# Hide the commit hash (id) column in main view
set main-view-id = no

# Show relative dates in blame view
set blame-view-date = relative

# Tab width in characters
set tab-size = 4

# Case-insensitive search with /
set ignore-case = yes


# Enable mouse scrolling
set mouse = yes

# Automatically refresh views when files change on disk
set refresh-mode = auto

# -- Colors -------------------------------------------------------------------

# Both blue areas below are fallbacks only — the real values are mode-specific
# and come from the source line at the end of this section, since ANSI blue is
# pale under the dark palette. They keep sane colors on a clone that has never
# toggled.

# Highlight the currently selected line
color cursor white blue bold

# Title bar of an inactive (blurred) view — black reads on either palette
color title-blur white black

# Title bar of the active (focused) view
color title-focus white blue bold

# Per-mode overrides, last so they win: theme-active.tigrc is a symlink to
# theme-{dark,light}.tigrc that toggle_theme.sh flips, the same idiom as
# Ghostty's theme-active.conf and the k9s skin. -q keeps tig quiet when the
# symlink is absent (never toggled, or a clone outside ~/.rc), leaving
# the fallback above in place. tig reads this at startup only.
source -q ~/.rc/tig/theme-active.tigrc

# -- Key bindings: main view --------------------------------------------------

# Checkout the selected commit (detached HEAD)
bind main O !git checkout %(commit)

# Create a new branch from the selected commit (prompts for branch name)
bind main B !git checkout -b %(prompt) %(commit)

# Push the current branch to its remote
bind main P !git push

# Fetch from all remotes
bind main F !git fetch --all

# Revert the selected commit (creates a new undo commit)
bind main ! !git revert %(commit)

# Show selected commit via delta (syntax-highlighted unified diff).
# q exits the pager and returns to tig.
bind main D !sh -c "git show %(commit) | delta --paging=always"

# Copy bindings — dispatch to pbcopy (macOS) or xclip (Linux).
# Generic Y copies file path; per-view overrides copy commit/branch instead.
bind generic Y !@sh -c "printf %s %(file)   | { command -v pbcopy >/dev/null && pbcopy || xclip -selection clipboard; }"
bind main    Y !@sh -c "printf %s %(commit) | { command -v pbcopy >/dev/null && pbcopy || xclip -selection clipboard; }"
bind blame   Y !@sh -c "printf %s %(commit) | { command -v pbcopy >/dev/null && pbcopy || xclip -selection clipboard; }"
bind refs    Y !@sh -c "printf %s %(branch) | { command -v pbcopy >/dev/null && pbcopy || xclip -selection clipboard; }"

# -- Key bindings: diff view --------------------------------------------------

# Shrink the diff context by 3 lines
bind diff [ :toggle diff-context -3

# Expand the diff context by 3 lines
bind diff ] :toggle diff-context +3

# -- Key bindings: status view ------------------------------------------------

# Amend the last commit
bind status A !git commit --amend

# Push the current branch to its remote
bind status P !git push

# Stash current uncommitted changes
bind status S !git stash push

# Restore (discard changes to) tracked file
bind status R ?git checkout -- %(file)

# Delete untracked file
bind status D ?git clean -f -- %(file)

# -- Key bindings: stash view -------------------------------------------------

# Apply and remove the selected stash entry
bind stash P !git stash pop

# Drop (delete) the selected stash entry
bind stash D !git stash drop %(stash)

# -- Key bindings: generic (all views) ----------------------------------------

# Jump to the first line (vim-style)
bind generic g move-first-line

# Jump to the last line (vim-style)
bind generic G move-last-line

# Scroll one page down
bind generic <Ctrl-f> move-page-down

# Scroll one page up
bind generic <Ctrl-b> move-page-up

# Treat Space like Enter (open/view selection)
bind generic <Space> enter
